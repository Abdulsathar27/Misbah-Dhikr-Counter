<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values-v31: without this copy, values-night would win in dark
         mode and the system splash would show the app icon again. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>
</resources>
